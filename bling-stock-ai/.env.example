# ---------------------------------------------------------------- servidor
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://blingstock:troque-esta-senha@localhost:5432/blingstock
# Endereço público da aplicação (sem barra no final)
APP_ORIGIN=https://estoque.suaempresa.com.br
# 32 bytes aleatórios em base64 — gere com:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
# true quando servido via HTTPS (padrão em produção)
COOKIE_SECURE=true
APP_TIMEZONE=America/Sao_Paulo
# Executa sincronização/jobs no mesmo processo web (false se usar "npm run start:worker" separado)
RUN_WORKER_IN_PROCESS=true

# ---------------------------------------------------------------- Bling (app cadastrado na Central de Extensões / área do desenvolvedor)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Deve ser idêntica à URL de redirecionamento cadastrada no app do Bling:
BLING_REDIRECT_URI=https://estoque.suaempresa.com.br/api/bling/callback
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_OAUTH_BASE_URL=https://www.bling.com.br/Api/v3
BLING_WEBHOOK_SIGNATURE_HEADER=x-bling-signature-256
BLING_REQUESTS_PER_SECOND=3

# ---------------------------------------------------------------- IA (opcional — sem chave, usa o interpretador local)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
