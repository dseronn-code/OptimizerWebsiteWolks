# ---------------------------------------------------------------- servidor
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://blingstock:troque-esta-senha@localhost:5432/blingstock
# Endereço público da aplicação (sem barra no final)
APP_ORIGIN=https://estoque.suaempresa.com.br
# 32 bytes aleatórios em base64 — gere com:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
# true quando servido via HTTPS (padrão em produção)
COOKIE_SECURE=true
APP_TIMEZONE=America/Sao_Paulo
# Executa sincronização/jobs no mesmo processo web (false se usar "npm run start:worker" separado)
RUN_WORKER_IN_PROCESS=true

# ---------------------------------------------------------------- Bling (app cadastrado na Central de Extensões / área do desenvolvedor)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Deve ser idêntica à URL de redirecionamento cadastrada no app do Bling:
BLING_REDIRECT_URI=https://estoque.suaempresa.com.br/api/bling/callback
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_OAUTH_BASE_URL=https://www.bling.com.br/Api/v3
BLING_WEBHOOK_SIGNATURE_HEADER=x-bling-signature-256
BLING_REQUESTS_PER_SECOND=3

# ---------------------------------------------------------------- E-mail (código de confirmação do "Criar conta")
# brevo (grátis até 300/dia) | resend | console (só desenvolvimento: o código aparece no log)
EMAIL_PROVIDER=brevo
EMAIL_FROM=estoque@suaempresa.com.br     # remetente verificado no Brevo
EMAIL_FROM_NAME=ITCOMTECH Estoque
BREVO_API_KEY=
#RESEND_API_KEY=

# ---------------------------------------------------------------- IA (opcional — sem IA configurada, usa o interpretador local)
# auto | anthropic | openai_compat | local
AI_PROVIDER=auto

# Opção GRATUITA 1 — Groq (crie a chave em https://console.groq.com/keys)
#AI_BASE_URL=https://api.groq.com/openai/v1
#AI_API_KEY=gsk_...
#AI_MODEL=openai/gpt-oss-20b          # confira os modelos disponíveis em https://console.groq.com/docs/models

# Opção GRATUITA 2 — Google Gemini (crie a chave em https://aistudio.google.com/apikey)
#AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#AI_API_KEY=AIza...
#AI_MODEL=gemini-2.5-flash            # confira os modelos disponíveis no Google AI Studio

# Opção paga — Anthropic
ANTHROPIC_API_KEY=
# Só para chaves sem workspace vinculado (erro "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=
#AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
